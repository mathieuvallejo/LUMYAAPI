    "/pro/verify": {
      "post": {
        "tags": ["Professionnel"],
        "summary": "Vérifier un professionnel de santé via le RPPS",
        "description": "Interroge l'open data data.gouv.fr pour vérifier qu'un professionnel existe avec ce nom et ce SIRET",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyPro" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Professionnel vérifié avec succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "400": {
            "description": "Champs manquants",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Professionnel non trouvé dans le RPPS",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/pro/upgrade/{id}": {
      "put": {
        "tags": ["Professionnel"],
        "summary": "Passer un compte utilisateur en compte professionnel",
        "description": "Re-vérifie le professionnel côté serveur puis met à jour le typeRole en 'pro'",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyPro" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compte passé en professionnel",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Champs manquants",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "Professionnel non trouvé dans le RPPS",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      },
      "IdUserPath": {
        "name": "idUser",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      },
      "IdVideoPath": {
        "name": "idVideo",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      },
      "IdCommentairePath": {
        "name": "idCommentaire",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Token invalide ou manquant",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "InternalError": {
        "description": "Erreur interne du serveur",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "idUser": { "type": "integer", "example": 1 },
          "pseudo": { "type": "string", "example": "pseudo" },
          "nom": { "type": "string", "example": "Dupont" },
          "prenom": { "type": "string", "example": "Jean" },
          "email": { "type": "string", "example": "jean@example.com" },
          "dateNaissance": { "type": "string", "format": "date" },
          "typeRole": { "type": "string", "example": "user", "enum": ["user", "pro"] },
          "bio": { "type": "string", "example": "Ma bio" },
          "pdp": { "type": "string", "example": "https://example.com/avatar.jpg" },
          "dateCreation": { "type": "string", "format": "date-time" },
          "suivi": { "type": "integer", "example": 0 }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "nom": { "type": "string", "example": "Dupont" },
          "prenom": { "type": "string", "example": "Jean" },
          "email": { "type": "string", "example": "jean@example.com" },
          "password": { "type": "string", "example": "******" },
